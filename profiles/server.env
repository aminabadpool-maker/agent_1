# High-throughput server profile
MB_WIDTH=1280
MB_HEIGHT=720
FPS=24
CRF=18
OUT_BASE="renders/srv_run"
MERGED_DIR="renders/srv_run/merged"
OUT_MP4="renders/srv_run/out.mp4"
MOVE_FILES=1
CLEAN_PPM=1
HOOK_POST_COLLECT='echo "[PKG post-collect] PPM count in $MERGED_DIR: $(find "$MERGED_DIR" -maxdepth 1 -name "frame_*.ppm" | wc -l)"'
HOOK_POST_ENCODE='./tools/post_encode_check.sh "$OUT_MP4"'
